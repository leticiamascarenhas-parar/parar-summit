---
// Bandeirinha do país do palestrante. Quem usa define largura/altura via :global(.bandeira)
const { pais } = Astro.props;
---

{pais === "us" && (
  <span class="bandeira" role="img" aria-label="Estados Unidos">
    <svg viewBox="0 0 30 20" aria-hidden="true">
      <rect width="30" height="20" fill="#B22234"></rect>
      <path d="M0 2.3h30M0 5.4h30M0 8.5h30M0 11.6h30M0 14.7h30M0 17.8h30" stroke="#ffffff" stroke-width="1.55"></path>
      <rect width="12" height="10.8" fill="#3C3B6E"></rect>
      <g fill="#ffffff">
        <circle cx="2" cy="1.8" r="0.65"></circle><circle cx="5" cy="1.8" r="0.65"></circle><circle cx="8" cy="1.8" r="0.65"></circle><circle cx="11" cy="1.8" r="0.65"></circle>
        <circle cx="3.5" cy="3.9" r="0.65"></circle><circle cx="6.5" cy="3.9" r="0.65"></circle><circle cx="9.5" cy="3.9" r="0.65"></circle>
        <circle cx="2" cy="6" r="0.65"></circle><circle cx="5" cy="6" r="0.65"></circle><circle cx="8" cy="6" r="0.65"></circle><circle cx="11" cy="6" r="0.65"></circle>
        <circle cx="3.5" cy="8.1" r="0.65"></circle><circle cx="6.5" cy="8.1" r="0.65"></circle><circle cx="9.5" cy="8.1" r="0.65"></circle>
      </g>
    </svg>
  </span>
)}

{pais === "uy" && (
  <span class="bandeira" role="img" aria-label="Uruguai">
    <svg viewBox="0 0 30 20" aria-hidden="true">
      <rect width="30" height="20" fill="#ffffff"></rect>
      <path d="M0 3.33h30M0 7.78h30M0 12.22h30M0 16.67h30" stroke="#0038A8" stroke-width="2.22"></path>
      <rect width="11.11" height="11.11" fill="#ffffff"></rect>
      <polygon points="5.56,1.26 6.13,2.72 7.21,1.59 7.17,3.15 8.60,2.52 7.97,3.95 9.53,3.91 8.40,4.99 9.86,5.56 8.40,6.13 9.53,7.21 7.97,7.17 8.60,8.60 7.17,7.97 7.21,9.53 6.13,8.40 5.56,9.86 4.99,8.40 3.91,9.53 3.95,7.97 2.52,8.60 3.15,7.17 1.59,7.21 2.72,6.13 1.26,5.56 2.72,4.99 1.59,3.91 3.15,3.95 2.52,2.52 3.95,3.15 3.91,1.59 4.99,2.72" fill="#FCD116" stroke="#7B3F00" stroke-width="0.25" stroke-linejoin="round"></polygon>
      <circle cx="5.56" cy="5.56" r="2.2" fill="#FCD116" stroke="#7B3F00" stroke-width="0.25"></circle>
    </svg>
  </span>
)}

<style>
  .bandeira {
    display: inline-block;
    flex: 0 0 auto;
    overflow: hidden;
    border: 2px solid #ffffff;
    border-radius: 4px;
    box-sizing: border-box;
    line-height: 0;
  }

  .bandeira svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
