---
import { trilhas } from "../data/trilhas";
import TrilhaCard from "./TrilhaCard.astro";
---

<section class="trilhas-section" id="trilhas">
  <div class="trilhas-header">
    <div class="trilhas-title-block">
      <span class="trilhas-new">NEW</span>
      <span class="trilhas-kicker">PARAR SUMMIT 26</span>
      <h2 class="titulo-trilhas">Trilhas <span>Simultâneas</span></h2>
    </div>
  </div>

  <div class="tabs-wrapper">
    <button
      class="tabs-arrow tabs-arrow-left"
      type="button"
      aria-label="Ver trilhas anteriores"
    >
      ‹
    </button>

    <div class="tabs">
      {trilhas.map((trilha, index) => (
        <button
          class={`tab ${index === 0 ? "active" : ""}`}
          type="button"
          data-tab={trilha.id}
        >
          {trilha.nome}
        </button>
      ))}
    </div>

    <button
      class="tabs-arrow tabs-arrow-right"
      type="button"
      aria-label="Ver próximas trilhas"
    >
      ›
    </button>
  </div>

  <div class="tracks">
    {trilhas.map((trilha, index) => (
      <div
        class={`track-shell ${index === 0 ? "active" : ""}`}
        data-track-shell={trilha.id}
      >
        <button
          class="track-arrow track-arrow-left"
          type="button"
          aria-label="Ver palestra anterior"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" />
          </svg>
        </button>

        <div
          class={`track ${index === 0 ? "active" : ""}`}
          data-track={trilha.id}
        >
          {trilha.palestras.map((palestra) => (
            <TrilhaCard
              {...palestra}
              trilha={trilha.nome}
              colegasDeMesa={
                palestra.mesa
                  ? trilha.palestras
                      .filter((p) => p.mesa === palestra.mesa && p !== palestra)
                      .map((p) => p.palestrante)
                  : []
              }
            />
          ))}
        </div>

        <button
          class="track-arrow track-arrow-right"
          type="button"
          aria-label="Ver próxima palestra"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    ))}
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;800;900&display=swap');

  .trilhas-section {
    --tr-navy: #004153;
    --tr-green: #08D16E;
    --tr-white: #FFFFFF;
    position: relative;
    overflow: hidden;
    padding: 110px 20px 100px;
    background: var(--tr-navy);
    border-top: 6px solid var(--tr-green);
    border-bottom: 6px solid var(--tr-green);
    font-family: "Montserrat", "Raleway", sans-serif;
  }

  /* Linhas curvas sutis, igual ao Test Drive */
  .trilhas-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1080' height='1350' viewBox='0 0 1080 1350' fill='none' stroke='rgba(8,209,110,0.18)' stroke-width='2'><path d='M-60 1400 L-60 520 A230 230 0 0 1 400 520 L400 1400'/><path d='M20 1400 L20 560 A150 150 0 0 1 320 560 L320 1400'/><path d='M600 -60 L600 640 A230 230 0 0 0 1060 640 L1060 -60'/><path d='M680 -60 L680 600 A150 150 0 0 0 980 600 L980 -60'/><path d='M860 1400 L860 1080 A200 200 0 0 1 1260 1080 L1260 1400'/></svg>");
    background-size: 1080px 1350px;
    background-position: center top;
    background-repeat: repeat;
    pointer-events: none;
  }

  .trilhas-header,
  .tabs-wrapper,
  .tracks {
    position: relative;
    z-index: 1;
  }

  /* Cabeçalho: bloco verde inclinado com "+" */
  .trilhas-header {
    width: min(1200px, 100%);
    margin: 0 auto 56px;
  }

  .trilhas-header::before,
  .trilhas-header::after {
    content: "";
    position: absolute;
    z-index: 2;
    background: var(--tr-white);
  }
  .trilhas-header::before { left: -18px; top: -22px; width: 64px; height: 20px; }
  .trilhas-header::after  { left: 4px;  top: -44px; width: 20px; height: 64px; }

  .trilhas-title-block {
    position: relative;
    background: var(--tr-green);
    color: var(--tr-navy);
    padding: 52px 64px 48px;
    clip-path: polygon(1.5% 0, 100% 0, 98.5% 100%, 0 100%);
  }

  .trilhas-new {
    position: absolute;
    top: 0;
    right: 64px;
    background: var(--tr-navy);
    color: var(--tr-green);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 3px;
    padding: 10px 18px;
    border-radius: 0 0 4px 4px;
  }

  .trilhas-kicker {
    display: block;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 6px;
    margin-bottom: 14px;
  }

  .titulo-trilhas {
    margin: 0;
    font-size: clamp(36px, 5.4vw, 76px);
    line-height: 0.98;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--tr-navy);
  }

  .titulo-trilhas span {
    display: inline-block;
    color: var(--tr-white);
    padding-bottom: 6px;
    border-bottom: 5px solid var(--tr-white);
  }

  /* Abas */
  .tabs-wrapper {
    width: min(1200px, 100%);
    margin: 0 auto 48px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tabs {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    padding: 5px 3px 8px;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0 20px;
    border: 2px solid rgba(8, 209, 110, 0.45);
    border-radius: 4px;
    background: transparent;
    color: var(--tr-white);
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .tab:hover {
    transform: translateY(-2px);
    border-color: var(--tr-green);
  }

  .tab.active {
    background: var(--tr-green);
    color: var(--tr-navy);
    border-color: var(--tr-green);
  }

  .tab:focus-visible,
  .tabs-arrow:focus-visible,
  .track-arrow:focus-visible {
    outline: 3px solid var(--tr-white);
    outline-offset: 3px;
  }

  .tabs-arrow {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--tr-white);
    color: var(--tr-navy);
    font-family: Arial, sans-serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      opacity 0.25s ease;
  }

  .tabs-arrow:hover:not(:disabled) {
    transform: scale(1.06);
    background: var(--tr-green);
  }

  .tabs-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .track-shell {
    position: relative;
    display: none;
    width: 100%;
  }

  .track-shell.active {
    display: block;
  }

  .track {
    display: none;
    width: min(1200px, 100%);
    margin: 0 auto;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: nowrap;
    gap: 40px;
  }

  .track.active {
    display: flex;
  }

  /* --- Setas dos cards (mobile) --- */
  .track-arrow {
    position: absolute;
    top: 50%;
    z-index: 20;
    width: 44px;
    height: 44px;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--tr-green);
    color: var(--tr-navy);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transform: translateY(-50%) scale(1);
    transition:
      transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      background 0.25s ease,
      color 0.25s ease;
  }

  .track-arrow:hover:not(:disabled),
  .track-arrow:active:not(:disabled) {
    transform: translateY(-50%) scale(1.12);
    background: var(--tr-white);
    color: var(--tr-navy);
  }

  .track-arrow svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2.8;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .track-arrow-left {
    left: 8px;
  }

  .track-arrow-right {
    right: 8px;
  }

  .track:has(:global(.trilha-card.selected))
    :global(.trilha-card:not(.selected)) {
    opacity: 0.28;
    transform: scale(0.96);
    filter: saturate(0.65);
  }

  /* --- Mobile --- */
  @media (max-width: 900px) {
    .trilhas-section {
      padding: 80px 0 68px;
    }

    .trilhas-header {
      width: auto;
      margin: 0 20px 36px;
    }

    .trilhas-title-block {
      padding: 48px 28px 34px;
      clip-path: polygon(3% 0, 100% 0, 97% 100%, 0 100%);
    }

    .trilhas-new {
      right: 28px;
      font-size: 12px;
      padding: 8px 14px;
    }

    .titulo-trilhas {
      font-size: clamp(34px, 10vw, 48px);
    }

    .tabs-wrapper {
      width: 100%;
      box-sizing: border-box;
      gap: 7px;
      margin-bottom: 34px;
      padding: 0 10px;
    }

    .tabs {
      padding-block: 5px 9px;
    }

    .tabs-arrow {
      width: 38px;
      height: 38px;
      font-size: 25px;
    }

    .tab {
      min-height: 40px;
      padding: 0 16px;
      font-size: 11px;
    }

    .track-shell.active.has-many .track-arrow.visible {
      display: inline-flex !important;
    }

    .track.active {
      justify-content: flex-start;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      gap: 16px;

      /* Card = 290px; 50vw - 145px centraliza o primeiro e o último card exatamente na tela */
      padding: 12px calc(50vw - 145px) 28px;
      scroll-padding-inline: calc(50vw - 145px);

      scroll-behavior: smooth;
      scroll-snap-type: x mandatory;
      box-sizing: border-box;
    }

    .track.active::-webkit-scrollbar {
      display: none;
    }

    .track.active :global(.trilha-card) {
      scroll-snap-align: center;
      scroll-snap-stop: always;
      flex: 0 0 290px !important;
      width: 290px !important;
      max-width: 290px !important;
      box-sizing: border-box;
    }
  }

  @media (max-width: 480px) {
    .trilhas-section {
      padding-top: 72px;
    }

    .tabs-wrapper {
      padding-inline: 8px;
    }

    .tabs-arrow {
      width: 36px;
      height: 36px;
      font-size: 23px;
    }

    .tab {
      min-height: 38px;
      padding: 0 14px;
      font-size: 10px;
    }
  }

  @media (min-width: 901px) {
    .track-arrow {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tabs,
    .track.active {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  function setupTrackNavigation(section) {
    const trackShells = section.querySelectorAll('.track-shell');
    const tabs = section.querySelectorAll('.tab');
    const tabsContainer = section.querySelector('.tabs');
    const tabsLeft = section.querySelector('.tabs-arrow-left');
    const tabsRight = section.querySelector('.tabs-arrow-right');

    if (!tabsContainer) return;

    // Navegação das abas superiores
    const updateTabArrows = () => {
      const maxScroll = tabsContainer.scrollWidth - tabsContainer.clientWidth;
      if (tabsLeft instanceof HTMLButtonElement) {
        tabsLeft.disabled = tabsContainer.scrollLeft <= 4;
      }
      if (tabsRight instanceof HTMLButtonElement) {
        tabsRight.disabled = tabsContainer.scrollLeft >= maxScroll - 4;
      }
    };

    tabsLeft?.addEventListener('click', () => {
      tabsContainer.scrollBy({ left: -760, behavior: 'smooth' });
    });

    tabsRight?.addEventListener('click', () => {
      tabsContainer.scrollBy({ left: 760, behavior: 'smooth' });
    });

    tabsContainer.addEventListener('scroll', updateTabArrows, { passive: true });
    updateTabArrows();

    function obterCards(track) {
      return Array.from(track.querySelectorAll('.trilha-card'));
    }

    function obterIndiceAtivo(track) {
      const cards = obterCards(track);
      if (cards.length === 0) return 0;

      const containerCenter = track.scrollLeft + track.clientWidth / 2;
      let activeIndex = 0;
      let menorDistancia = Infinity;

      cards.forEach((card, index) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const distancia = Math.abs(cardCenter - containerCenter);
        if (distancia < menorDistancia) {
          menorDistancia = distancia;
          activeIndex = index;
        }
      });

      return activeIndex;
    }

    function navegarParaCard(track, targetIndex) {
      const cards = obterCards(track);
      const card = cards[targetIndex];
      if (!card) return;

      // scrollIntoView com inline: 'center' faz o navegador usar o alinhamento perfeito de CSS Snap
      card.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center'
      });
    }

    function atualizarSetas(shell) {
      const track = shell.querySelector('.track');
      if (!(track instanceof HTMLElement)) return;

      const cards = obterCards(track);
      const leftArrow = shell.querySelector('.track-arrow-left');
      const rightArrow = shell.querySelector('.track-arrow-right');

      // 1 Card -> Oculta AMBAS
      if (cards.length <= 1) {
        shell.classList.remove('has-many');
        leftArrow?.classList.remove('visible');
        rightArrow?.classList.remove('visible');
        return;
      }

      shell.classList.add('has-many');
      const activeIndex = obterIndiceAtivo(track);

      // Regras de Exibição das setas
      if (leftArrow instanceof HTMLElement) {
        if (activeIndex > 0) {
          leftArrow.classList.add('visible');
        } else {
          leftArrow.classList.remove('visible');
        }
      }

      if (rightArrow instanceof HTMLElement) {
        if (activeIndex < cards.length - 1) {
          rightArrow.classList.add('visible');
        } else {
          rightArrow.classList.remove('visible');
        }
      }
    }

    trackShells.forEach((shell) => {
      const track = shell.querySelector('.track');
      const leftArrow = shell.querySelector('.track-arrow-left');
      const rightArrow = shell.querySelector('.track-arrow-right');

      if (!(track instanceof HTMLElement)) return;

      leftArrow?.addEventListener('click', (e) => {
        e.preventDefault();
        const activeIndex = obterIndiceAtivo(track);
        if (activeIndex > 0) {
          navegarParaCard(track, activeIndex - 1);
        }
      });

      rightArrow?.addEventListener('click', (e) => {
        e.preventDefault();
        const activeIndex = obterIndiceAtivo(track);
        const cards = obterCards(track);
        if (activeIndex < cards.length - 1) {
          navegarParaCard(track, activeIndex + 1);
        }
      });

      track.addEventListener('scroll', () => {
        window.requestAnimationFrame(() => atualizarSetas(shell));
      }, { passive: true });

      atualizarSetas(shell);
    });

    // Troca de Abas
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        const selectedShell = section.querySelector(`[data-track-shell="${target}"]`);
        const selectedTrack = section.querySelector(`[data-track="${target}"]`);

        tabs.forEach((item) => item.classList.remove('active'));
        trackShells.forEach((shell) => shell.classList.remove('active'));
        section.querySelectorAll('.track').forEach((t) => t.classList.remove('active'));

        tab.classList.add('active');

        if (selectedShell instanceof HTMLElement && selectedTrack instanceof HTMLElement) {
          selectedShell.classList.add('active');
          selectedTrack.classList.add('active');
          
          window.requestAnimationFrame(() => {
            navegarParaCard(selectedTrack, 0);
            atualizarSetas(selectedShell);
          });
        }

        tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      });
    });

    window.addEventListener('resize', () => {
      const activeShell = section.querySelector('.track-shell.active');
      if (activeShell instanceof HTMLElement) {
        atualizarSetas(activeShell);
      }
    });
  }

  function initTrilhas() {
    document.querySelectorAll('.trilhas-section').forEach((section) => {
      if (!(section instanceof HTMLElement)) return;
      if (section.dataset.ready === 'true') return;
      section.dataset.ready = 'true';
      setupTrackNavigation(section);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTrilhas, { once: true });
  } else {
    initTrilhas();
  }

  document.addEventListener('astro:page-load', initTrilhas);
</script>