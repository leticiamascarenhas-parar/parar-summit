---
// PararAwards.astro
// Uso básico: <PararAwards />
// Uso customizado: veja os Props abaixo

export interface Sponsor {
  name: string;
  logo: string;
  href?: string;
  // logo com muita área vazia em cima/embaixo: ocupa a largura toda do quadrinho
  wide?: boolean;
}

export interface Category {
  icon: "truck" | "users" | "shield";
  title: string;
  desc: string;
  sponsors?: Sponsor[];
}

interface Props {
  logo?: string;
  bgImage?: string;
  eyebrow?: string;
  title?: string;
  categoriesTitle?: string;
  categories?: Category[];
}

const {
  logo = "/images/parar-awards.png",
  bgImage = "/images/parar-awards-bg.webp",
  eyebrow = "AWARDS 2025",
  title = "PARAR",
  categoriesTitle = "Categorias",
  categories = [
    {
      icon: "truck",
      title: "A Melhor Frota do Brasil",
      desc: "Reconhece a operação com os melhores indicadores de eficiência e resultado.",
      sponsors: [
        { name: "GWM", logo: "https://institutoparar.com.br/wp-content/uploads/2025/09/GWM-LOGO.png", href: "https://www.gwmmotors.com.br/pt" },
        { name: "Sem Parar", logo: "https://institutoparar.com.br/wp-content/uploads/2025/07/5.png", href: "https://www.sempararempresas.com.br/" },
        { name: "Pró-Frotas", logo: "https://institutoparar.com.br/wp-content/uploads/2026/09/PRO-FROTAS-3.png", href: "https://www.profrotas.com.br/", wide: true },
      ],
    },
    {
      icon: "users",
      title: "O Melhor Gestor de Frotas do Brasil",
      desc: "Celebra a liderança que transforma pessoas, processos e desempenho.",
      sponsors: [
        { name: "Monaco", logo: "https://institutoparar.com.br/wp-content/uploads/2025/07/LOGOS-LP-PARAR-SUMMIT-8.png", href: "https://monacobr.com.br/" },
        { name: "Localiza", logo: "https://institutoparar.com.br/wp-content/uploads/2025/09/LOGOS-LP-PARAR-SUMMIT-18.png", href: "https://frotas.localiza.com/empresas?utm_source=site-evento-parar&utm_medium=botao&utm_campaign=ll-trade_gf_evento-parar-summit_topo_site-evento-parar_botao_alcance" },
        { name: "Veloe Go", logo: "https://institutoparar.com.br/wp-content/uploads/2026/08/VELOE.png", href: "https://veloe.com.br/veloego" },
      ],
    },
    {
      icon: "shield",
      title: "A Frota Mais Segura do Brasil",
      desc: "Premia a excelência em segurança viária e prevenção de acidentes.",
      sponsors: [
        { name: "Ticket Log", logo: "https://institutoparar.com.br/wp-content/uploads/2025/07/LOGOS-LP-PARAR-SUMMIT.png", href: "https://www.ticketlog.com.br/" },
        { name: "VEIC", logo: "https://institutoparar.com.br/wp-content/uploads/2026/07/VEIC-1.png", href: "https://veic.com.br/" },
        { name: "Unidas", logo: "https://institutoparar.com.br/wp-content/uploads/2026/05/logo-unidas-1.png", href: "https://frotas.unidas.com.br/" },
      ],
    },
  ],
} = Astro.props;

const icons: Record<Category["icon"], string> = {
  truck: `<path d="M2 8h11v8H2z"/><path d="M13 11h4l3 3v2h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="16.5" cy="18" r="1.6"/>`,
  users: `<circle cx="8.5" cy="8" r="3"/><path d="M2.5 19c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15 13.2c2.4.3 4.3 2.3 4.5 4.8"/>`,
  shield: `<path d="M12 2 4 5v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V5z"/><path d="m8.5 12 2.3 2.3L15.5 9"/>`,
};
---

<section id="parar-awards" class="parar-awards max-md:px-4 max-md:py-14" style={`--bg-image: url(${bgImage});`}>
  <div class="pa-inner max-md:flex max-md:flex-col max-md:items-center max-md:justify-center max-md:gap-8">

    <div class="pa-left max-md:flex max-md:flex-col max-md:items-center max-md:text-center">
      <div class="pa-brand max-md:flex max-md:justify-center">
        <img class="pa-logo max-md:mx-auto" src={logo} alt={`${title} ${eyebrow}`} />
      </div>

      <div class="pa-copy max-md:text-center">
        <p>
          Anualmente, o Instituto PARAR promove um grande momento de
          premiação a fim de reconhecer profissionais, empresas e projetos
          que têm se destacado no cenário de gestão de frotas no Brasil.
        </p>
        <p>
          Em 2026, as inscrições ficaram abertas até o dia
          <strong> 31 de agosto</strong>, e os vencedores serão anunciados
          durante o <strong>PARAR Summit 26</strong>, o evento mais relevante
          em Gestão de Frotas da América Latina.
        </p>
      </div>

    </div>

    <div class="pa-right max-md:flex max-md:flex-col max-md:items-center max-md:text-center">
      <div class="pa-cat-heading max-md:flex-col max-md:justify-center max-md:gap-3">
        <span class="pa-cat-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M8 4h8v4a4 4 0 0 1-8 0z"/>
            <path d="M8 4H4v1a4 4 0 0 0 4 4"/>
            <path d="M16 4h4v1a4 4 0 0 1-4 4"/>
            <path d="M12 12v4"/>
            <path d="M9 20h6"/>
            <path d="M10 16h4l1 4H9z"/>
          </svg>
        </span>
        <h2>{categoriesTitle}</h2>
      </div>

      <ul class="pa-cat-list max-md:w-full max-md:items-stretch">
        {categories.map((c) => (
          <li class="pa-cat-card max-md:flex-col max-md:items-center max-md:text-center max-md:gap-4">
            <span class="pa-cat-card-icon" set:html={`<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${icons[c.icon]}</svg>`} />
            <div>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>

              {c.sponsors && c.sponsors.length > 0 && (
                <div class="pa-sponsors">
                  <span class="pa-sponsors-label">Patrocínio</span>
                  <ul class="pa-sponsors-logos">
                    {c.sponsors.map((s) => (
                      <li>
                        <a class:list={{ "is-wide": s.wide }} href={s.href} target="_blank" rel="noopener noreferrer" title={s.name}>
                          <img src={s.logo} alt={s.name} loading="lazy" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  .parar-awards {
    --bg: #0a0f1e;
    --card-bg: #101a30;
    --card-border: #1e2c4a;
    --gold: #dab462;
    --gold-soft: #f4c860;
    --ink-soft: #b9c2d6;
    font-family: 'Raleway', 'Arial', sans-serif;


    position: relative;
    background: var(--bg-image) center / cover no-repeat, var(--bg);
    padding: 90px 24px;
    font-family: 'Raleway', 'Arial', sans-serif;
    color: #fff;
  }

  /* véu escuro sobre a imagem de fundo, pra garantir legibilidade do texto */
  .parar-awards::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 12, 24, 0.88), rgba(8, 12, 24, 0.82));
    z-index: 0;
  }

  .pa-inner {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: 72px;
    align-items: center; /* centraliza o texto em relação às categorias */
  }

  /* ---------- Coluna esquerda ---------- */
  .pa-brand {
    margin-bottom: 34px;
  }

  .pa-logo {
    height: 168px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  .pa-copy p {
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 0 20px;
  }

  .pa-copy strong {
    color: var(--gold-soft);
    font-weight: 700;
  }

  .pa-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding: 16px 30px;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--gold-soft), var(--gold));
    color: #201404;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 10px 26px rgba(242, 184, 60, 0.28);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pa-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(242, 184, 60, 0.38);
  }

  .pa-cta svg {
    transition: transform 0.2s ease;
  }

  .pa-cta:hover svg {
    transform: translateX(3px);
  }

  /* ---------- Coluna direita ---------- */
  .pa-cat-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 26px;
  }

  .pa-cat-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--gold);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pa-cat-heading h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 0.5px;
    color: var(--gold);
    text-transform: uppercase;
  }

  .pa-cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .pa-cat-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 22px 24px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .pa-cat-card:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
  }

  .pa-cat-card-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: #0a1326;
    border: 1px solid var(--card-border);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pa-cat-card h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 800;
    color: #fff;
  }

  .pa-cat-card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .pa-cat-card > div {
    flex: 1;
    min-width: 0;
  }

  /* ---------- Patrocinadores da categoria ---------- */
  .pa-sponsors {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--card-border);
  }

  .pa-sponsors-label {
    display: block;
    margin-bottom: 10px;
    color: var(--gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .pa-sponsors-logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  /* fundo branco: as logos são feitas para fundo claro */
  .pa-sponsors-logos a {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 46px;
    padding: 5px 10px;
    border-radius: 10px;
    background: #ffffff;
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pa-sponsors-logos a:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
  }

  .pa-sponsors-logos a:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .pa-sponsors-logos img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* logo larga (ex.: Pró-Frotas): a imagem ocupa a largura toda; o que sobra
     em cima/embaixo é só área transparente e fica escondido pelo quadrinho */
  .pa-sponsors-logos a.is-wide {
    padding-inline: 4px;
    overflow: hidden;
  }

  .pa-sponsors-logos a.is-wide img {
    width: 73%;
    height: auto;
    max-height: none;
  }

  /* ---------- Responsivo ---------- */
  @media (max-width: 980px) {
    .pa-inner {
      grid-template-columns: 1fr;
      gap: 56px;
      align-items: center;
      justify-items: center;
      text-align: center;
    }

    .pa-left,
    .pa-right {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
    }

    .pa-logo {
      margin: 0 auto;
    }

    .pa-copy p {
      text-align: center;
    }

    .pa-cta {
      margin-inline: auto;
    }

    .pa-cat-heading {
      justify-content: center;
    }

    .pa-cat-card {
      align-items: center;
      text-align: center;
      justify-content: center;
    }

    .pa-cat-card > div {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .parar-awards {
      padding: 60px 18px;
    }
    .pa-logo {
      height: 128px;
    }
    .pa-cat-heading h2 {
      font-size: 22px;
    }
    .pa-sponsors-logos {
      gap: 8px;
    }
    .pa-sponsors-logos a {
      height: 46px;
      padding: 6px 8px;
    }
  }
</style>
