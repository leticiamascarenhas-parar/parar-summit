---
import Bandeira from "./Bandeira.astro";

const {
  nome,
  cargo,
  descricao,
  foto,
  palestra,
  detalhes,
  dia,
  horario,
  mesa,
  mesaPanelId,
  mediador,
  bandeira
} = Astro.props;

// mesa = tema da mesa de debate. Esses cards não viram: abrem o painel da mesa (ver Plenaria.astro)
const ariaLabel = mesa
  ? `Ver participantes da mesa ${mesa}`
  : `Ver palestra de ${nome}`;
---

<article class="speaker-card" data-mesa={mesa ? "true" : undefined}>
  <button
    class="speaker-card-button"
    type="button"
    aria-label={ariaLabel}
    aria-expanded="false"
    aria-controls={mesaPanelId}
  >
    <div class="speaker-card-inner">

      <!-- FRENTE -->
      <div class="speaker-card-face speaker-card-front">
        <div class="speaker-photo">
          <img src={foto} alt={nome} loading="lazy" />

          <div class="photo-gradient"></div>

          {bandeira && (
            <span class="speaker-flag">
              <Bandeira pais={bandeira} />
            </span>
          )}

          {(dia || horario) && (
            <div class="speaker-when">
              {dia && (
                <span class="when-day">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                  {dia}
                </span>
              )}
              {horario && (
                <span class="when-time">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  {horario}
                </span>
              )}
            </div>
          )}

          <div class="speaker-summary">
            <span class="speaker-label">
              {mesa ? "MESA DE DEBATE" : "PALESTRANTE"}
              {mediador && <span class="speaker-mediador">Mediação</span>}
            </span>
            <h3>{nome}</h3>
            <p>{cargo}</p>
          </div>

          <span class="speaker-action">
            <span>{mesa ? "Ver mesa" : "Ver palestra"}</span>
            <span class="speaker-arrow" aria-hidden="true">→</span>
          </span>
        </div>
      </div>

      <!-- VERSO -->
      {!mesa && (
      <div class="speaker-card-face speaker-card-back">
        <div class="back-header">
          <span class="back-label">PALESTRA {bandeira && <Bandeira pais={bandeira} />}</span>

          <span class="back-close" aria-hidden="true">×</span>
        </div>

        <div class="back-content">
          {(dia || horario) && (
            <div class="speaker-when speaker-when--back">
              {dia && (
                <span class="when-day">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
                  {dia}
                </span>
              )}
              {horario && (
                <span class="when-time">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  {horario}
                </span>
              )}
            </div>
          )}

          <h3>{palestra}</h3>

          {detalhes && <p class="palestra-detalhes">{detalhes}</p>}
        </div>

        <small>Clique para voltar</small>
      </div>
      )}

    </div>
  </button>
</article>

<style>
  .speaker-card {
    width: 340px;
    aspect-ratio: 4 / 5.4;
    flex: 0 0 340px;

    perspective: 1500px;
    -webkit-perspective: 1500px; /* Adicionado para Safari/iOS */

    font-family: "Montserrat", "Raleway", sans-serif;

    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      filter 0.4s ease;
  }

  .speaker-card-button {
    width: 100%;
    height: 100%;

    padding: 0;
    border: 0;
    border-radius: 14px;

    background: transparent;
    color: inherit;

    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .speaker-card-inner {
    position: relative;

    width: 100%;
    height: 100%;

    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d; /* OBRIGATÓRIO para iOS */

    transition:
      transform 0.8s cubic-bezier(.2, .8, .2, 1);
  }

  .speaker-card.flipped .speaker-card-inner {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg); /* Adicionado para Safari/iOS */
  }

  .speaker-card-face {
    position: absolute;
    inset: 0;

    overflow: hidden;

    border: 2px solid #08D16E;
    border-radius: 14px;

    backface-visibility: hidden;
    -webkit-backface-visibility: hidden; /* OBRIGATÓRIO para iOS */

    box-sizing: border-box;

    /* sombra mais curta e suave, cabe no espaço do carrossel */
    box-shadow: 0 12px 26px rgba(0, 65, 83, 0.18);
  }

  /* FRENTE */

  .speaker-card-front {
    background: #004153;
    transform: rotateY(0deg) translateZ(1px); /* translateZ força a separação 3D no WebKit */
    -webkit-transform: rotateY(0deg) translateZ(1px);
  }

  .speaker-photo {
    position: relative;

    width: 100%;
    height: 100%;

    overflow: hidden;
    background: #004153;
  }

  .speaker-photo img {
    width: 100%;
    height: 100%;

    display: block;
    object-fit: cover;

    transition:
      transform 0.65s cubic-bezier(.22, 1, .36, 1),
      filter 0.45s ease;
  }

  .photo-gradient {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to top,
        rgba(0, 50, 64, 0.98) 0%,
        rgba(0, 50, 64, 0.85) 28%,
        rgba(0, 50, 64, 0.15) 60%,
        transparent 78%
      );
  }

  .speaker-summary {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 72px;

    z-index: 2;

    color: #ffffff;
  }

  .speaker-label {
    display: block;
    margin-bottom: 11px;

    color: #08D16E;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2.5px;
  }

  .speaker-summary h3 {
    max-width: 280px;
    margin: 0 0 10px;

    color: #ffffff;

    font-size: 28px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.3px;
    text-transform: uppercase;
  }

  .speaker-summary p {
    margin: 0;

    color: rgba(255, 255, 255, 0.82);

    font-size: 13px;
    line-height: 1.4;
    font-weight: 500;
  }

  .speaker-action {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 24px;

    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding-top: 15px;

    border-top: 1px solid rgba(255, 255, 255, 0.18);

    color: #08D16E;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .speaker-arrow {
    font-size: 20px;

    transition: transform 0.3s ease;
  }

  /* VERSO */

  .speaker-card-back {
    padding: 28px;

    display: flex;
    flex-direction: column;

    transform: rotateY(180deg) translateZ(1px); /* translateZ força a separação 3D no WebKit */
    -webkit-transform: rotateY(180deg) translateZ(1px);

    background:
      radial-gradient(
        circle at top right,
        rgba(8, 209, 110, 0.18),
        transparent 38%
      ),
      #004153;

    color: #ffffff;
    overflow: hidden;
  }

  .back-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    color: #08D16E;
  }

  .back-header > span:first-child {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.8px;
  }

  .back-close {
    width: 32px;
    height: 32px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;

    color: #ffffff;

    font-size: 23px;
    font-weight: 300;
  }

  .back-content {
    flex: 1;
    min-height: 0; /* deixa o flex encolher para o overflow funcionar */

    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 18px;

    /* texto longo rola por dentro do card */
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    margin: 0 -10px 10px 0;
    padding-right: 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(8, 209, 110, 0.6) transparent;
  }

  .back-content > * {
    flex-shrink: 0;
  }

  .back-content::-webkit-scrollbar {
    width: 4px;
  }

  .back-content::-webkit-scrollbar-thumb {
    background: rgba(8, 209, 110, 0.6);
    border-radius: 4px;
  }

  .back-content > h3 {
    margin: 0 0 18px;

    color: #ffffff;

    font-size: 30px;
    line-height: 1.05;
    font-weight: 900;
  }

  .palestra-detalhes {
    margin: 0;

    color: rgba(255, 255, 255, 0.82);

    font-size: 14px;
    line-height: 1.55;
  }


  .speaker-card-back small {
    color: rgba(255, 255, 255, 0.65);

    font-size: 10px;
    text-align: center;
  }

  /* DIA E HORÁRIO */

  .speaker-when {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 3;

    display: flex;
    align-items: stretch;

    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);

    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .when-day,
  .when-time {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
  }

  .when-day {
    background: #08D16E;
    color: #004153;
  }

  .when-time {
    background: #ffffff;
    color: #004153;
  }

  .speaker-when svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* No verso, o selo fica no fluxo do texto (não flutuando sobre a foto) */
  .speaker-when--back {
    position: static;
    align-self: flex-start;
    margin-top: 18px;
    box-shadow: none;
  }

  /* BANDEIRA (canto superior direito, o selo de dia/horário fica à esquerda) */

  .speaker-flag {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    line-height: 0;
    border-radius: 4px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }

  .speaker-flag :global(.bandeira) {
    width: 36px;
    height: 24px;
  }

  /* no verso, ao lado do rótulo PALESTRA */
  .back-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .back-label :global(.bandeira) {
    width: 24px;
    height: 16px;
    border-width: 1.5px;
    border-radius: 3px;
  }

  /* MESA DE DEBATE */

  .speaker-mediador {
    display: inline-block;
    margin-left: 8px;
    padding: 3px 6px;
    border-radius: 3px;

    background: #08D16E;
    color: #004153;

    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    vertical-align: 1px;
  }

  /* INTERAÇÃO */

  @media (hover: hover) {
    .speaker-card:not(.flipped):hover {
      transform: translateY(-8px);
    }

    .speaker-card:not(.flipped):hover .speaker-photo img {
      transform: scale(1.045);
      filter: brightness(1.04);
    }

    .speaker-card:not(.flipped):hover .speaker-arrow {
      transform: translateX(5px);
    }
  }

  :global(.plenaria-cards.has-flipped .speaker-card:not(.flipped)) {
    opacity: 0.25;
    transform: scale(0.96);
    filter: saturate(0.55);
  }

  .speaker-card.flipped {
    position: relative;
    z-index: 10;
    transform: translateY(-8px);
  }

  @media (max-width: 768px) {
    .speaker-card {
      width: 280px;
      min-width: 280px;
      flex-basis: 280px;
    }

    .speaker-summary {
      left: 21px;
      right: 21px;
      bottom: 64px;
    }

    .speaker-summary h3 {
      font-size: 25px;
    }



    .speaker-when {
      top: 14px;
      left: 14px;
      font-size: 12px;
    }

    .when-day,
    .when-time {
      padding: 8px 10px;
    }

    .speaker-action {
      left: 21px;
      right: 21px;
      bottom: 20px;
    }

    .speaker-card-back {
      padding: 23px;
    }

    .back-content > h3 {
      font-size: 25px;
    }
    
    .back-header > span:first-child {
      font-size: 10px;
    }

    .back-close {
      font-size: 21px;
    }

    .back-content > h3 {
      font-size: 23px;
    }

    .palestra-detalhes {
      font-size: 13px;
      line-height: 1.45;
    }

    .speaker-card-back small {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .speaker-card,
    .speaker-card-inner,
    .speaker-photo img,
    .speaker-arrow {
      transition: none;
    }
  }
</style>

<script>
  function iniciarSpeakerCards() {
    const cards = document.querySelectorAll('.speaker-card');

    cards.forEach((card) => {
      if (card.getAttribute('data-ready') === 'true') return;

      card.setAttribute('data-ready', 'true');

      // Cards de mesa não viram: quem abre o painel da mesa é o script da Plenaria.astro
      if (card.hasAttribute('data-mesa')) return;

      const button = card.querySelector('.speaker-card-button');

      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener('click', () => {
        const container = card.closest('.plenaria-cards');
        const estavaVirado = card.classList.contains('flipped');

        if (container) {
          container
            .querySelectorAll('.speaker-card')
            .forEach((item) => {
              item.classList.remove('flipped');

              const itemButton = item.querySelector(
                '.speaker-card-button'
              );

              itemButton?.setAttribute(
                'aria-expanded',
                'false'
              );
            });
        }

        if (!estavaVirado) {
          card.classList.add('flipped');
          button.setAttribute('aria-expanded', 'true');
        }

        if (container) {
          const temCardVirado =
            container.querySelector('.speaker-card.flipped');

          container.classList.toggle(
            'has-flipped',
            Boolean(temCardVirado)
          );
        }
      });
    });
  }

  iniciarSpeakerCards();

  document.addEventListener(
    'astro:page-load',
    iniciarSpeakerCards
  );
</script>