---
import EixoTag from "./EixoTag.astro";
import FavButton from "./FavButton.astro";
import { idTrilha } from "../data/agenda";

interface Props {
  titulo: string;
  palestrante: string;
  cargo: string;
  foto: string;
  horario: string;
  sala: string;
  trilha: string;
  trilhaId: string;
  id: number;
  mesa?: string;
  mediador?: boolean;
  // mesa de conteúdo: todos os palestrantes da mesa num único card
  palestrantes?: { palestrante: string; cargo: string; foto: string; mediador?: boolean }[];
}

const {
  titulo,
  palestrante,
  cargo,
  foto,
  horario,
  sala,
  trilha,
  trilhaId,
  id,
  mesa,
  mediador = false,
  palestrantes = []
} = Astro.props;

const isMesa = palestrantes.length > 1;
const favId = idTrilha(trilhaId, { id, mesa });

// "20/10 às 13h40" → data "20/10", hora "13h40", dia da semana "TER"
const [data, hora] = horario.split(/\s+às\s+/);
const [dia, mes] = data.split("/").map(Number);
const diasSemana = ["DOM", "SEG", "TER", "QUA", "QUI", "SEX", "SÁB"];
const diaSemana = dia && mes ? diasSemana[new Date(2026, mes - 1, dia).getDay()] : "";
// "sala: Lab 5" → "Lab 5"
const salaNome = sala.replace(/^sala:\s*/i, "");
---

<article class:list={["trilha-card", { "mesa-card": isMesa, "mesa-card-larga": palestrantes.length >= 4 }]}>
  <div class="trilha-card-corpo">
    <!-- Faixa de destaque: quando e onde -->
    <div class="trilha-card-when">
      <div class="when-date">
        {diaSemana && <span class="when-weekday">{diaSemana}</span>}
        <strong>{data}</strong>
      </div>

      {hora && <strong class="when-time">{hora}</strong>}

      <span class="when-room">
        <span class="when-room-label">sala:</span>
        {salaNome}
      </span>
    </div>

    <div class="trilha-card-photo">
      {isMesa ? (
        <div class="mesa-fotos">
          {palestrantes.map((p) => (
            <img src={p.foto} alt={p.palestrante} loading="lazy" decoding="async" />
          ))}
        </div>
      ) : (
        <img src={foto} alt={palestrante} loading="lazy" decoding="async" />
      )}

      {mesa && <span class="mesa-chip">{mediador && !isMesa ? "Mediador" : "Mesa de conteúdo"}</span>}

      <!-- Destaque do eixo temático -->
      <span class="eixo-pos"><EixoTag eixo={trilha} /></span>
    </div>

    <div class="trilha-card-info">
      {isMesa ? (
        <>
          <h4 class="titulo-palestra">{titulo}</h4>

          <ul class="mesa-palestrantes">
            {palestrantes.map((p) => (
              <li>
                <strong>{p.palestrante}</strong>
                {p.mediador && <em>Mediador</em>}
                <span>{p.cargo}</span>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <>
          <h3>{palestrante}</h3>
          <p class="cargo">{cargo}</p>

          <!-- Título em verde e fonte reduzida -->
          <h4 class="titulo-palestra">{titulo}</h4>
        </>
      )}
    </div>
  </div>

  <span class="fav-pos"><FavButton id={favId} titulo={titulo} /></span>
</article>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Raleway:wght@400;500;600;700;800&display=swap');

  .trilha-card {
    position: relative;
    width: 290px;
    min-width: 290px;
    max-width: 290px;
    /* altura mínima comum; cresce se o título for longo (a trilha iguala as alturas) */
    min-height: 538px;
    flex: 0 0 290px;
    box-sizing: border-box;
  }

  .trilha-card-corpo {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;

    padding: 0;
    border: 0;
    border-radius: 22px;
    overflow: hidden;

    background: #061827;
    color: #ffffff;

    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.18);
  }

  /* FAIXA DE DATA, HORÁRIO E SALA */

  .trilha-card-when {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;

    min-height: 54px;
    padding: 8px 16px 8px 18px;
    box-sizing: border-box;

    background: #00c264;
    color: #064852;
    border-radius: 22px 22px 0 0;
  }

  .when-date {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .when-weekday {
    margin-bottom: 2px;

    font-family: 'Raleway', 'Arial', sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .when-date strong,
  .when-time {
    font-family: 'Oswald', 'Arial', sans-serif;
    font-size: 24px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .when-time {
    padding-left: 14px;
    border-left: 2px solid rgba(6, 72, 82, 0.35);
    text-transform: uppercase;
  }

  .when-room {
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    padding: 6px 12px 7px;

    border-radius: 12px;
    background: #064852;
    color: #ffffff;

    font-family: 'Raleway', 'Arial', sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .when-room-label {
    margin-bottom: 3px;

    color: #00c264;
    font-size: 9px;
    letter-spacing: 0.16em;
  }

  .trilha-card-photo {
    position: relative;
    height: 250px;
    flex-shrink: 0;
    overflow: hidden;
    background: #061827;
    border: 3px solid #00c264;
    border-top: 0;
    border-bottom: 0;
  }

  .trilha-card-photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 15%;
  }

  /* EIXO TEMÁTICO: faixa sobre a base da foto */
  /* Estrela da agenda: canto superior direito da foto */
  .fav-pos {
    position: absolute;
    top: 67px;
    right: 14px;
    z-index: 2;
    line-height: 0;
  }

  .eixo-pos {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
  }

  .trilha-card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;

    padding: 22px 24px;
    border: 3px solid #00c264;
    border-top: 0;
    border-radius: 0 0 22px 22px;
    background: #061827;
  }

  .trilha-card-info h3 {
    margin: 0 0 6px;

    color: #ffffff;

    font-family: 'Oswald', 'Arial', sans-serif;
    font-size: 24px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cargo {
    margin: 0 0 12px;

    color: rgba(255, 255, 255, 0.72);

    font-family: 'Raleway', 'Arial', sans-serif;
    font-size: 13px;
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .titulo-palestra {
    margin: 0;

    color: #00c264;

    font-family: 'Oswald', 'Arial', sans-serif;
    font-size: 19px;
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: 0.02em;
  }


  .mesa-chip {
    position: absolute;
    top: 14px;
    left: 14px;

    padding: 7px 10px;
    border-radius: 6px;
    background: #004153;
    color: #08D16E;

    font-family: 'Raleway', 'Arial', sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;

    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.24);
  }

  /* Card único da mesa: mais largo, fotos lado a lado e lista de palestrantes */
  .trilha-card.mesa-card {
    width: 400px;
    min-width: 400px;
    max-width: 400px;
    flex: 0 0 400px;
    height: auto;
    min-height: 538px;
  }

  /* Mesas com 4+ palestrantes: mais largo para as fotos não ficarem estreitas */
  .trilha-card.mesa-card-larga {
    width: 520px;
    min-width: 520px;
    max-width: 520px;
    flex: 0 0 520px;
  }

  .mesa-fotos {
    display: flex;
    gap: 3px;
    height: 100%;
    background: #00c264;
  }

  .trilha-card-photo .mesa-fotos img {
    flex: 1 1 0;
    min-width: 0;
    width: auto;
  }

  .mesa-card .titulo-palestra {
    margin-bottom: 16px;
    font-size: 22px;
  }

  .mesa-palestrantes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mesa-palestrantes li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
    padding-left: 12px;
    border-left: 2px solid #00c264;
  }

  .mesa-palestrantes strong {
    color: #ffffff;
    font-family: 'Oswald', 'Arial', sans-serif;
    font-size: 17px;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mesa-palestrantes em {
    color: #00c264;
    font-family: 'Raleway', 'Arial', sans-serif;
    font-size: 10px;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mesa-palestrantes span {
    flex-basis: 100%;
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.72);
    font-family: 'Raleway', 'Arial', sans-serif;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .trilha-card-info {
      padding: 19px 20px;
    }

    .trilha-card-info h3 {
      font-size: 22px;
    }

    .titulo-palestra {
      font-size: 17px;
    }
  }
</style>

