<header class="site-header">
  <a href="/" class="logo" aria-label="Página inicial do PARAR Summit 26">
    <img src="/logos/logo-summit.svg" alt="PARAR Summit 26" />
  </a>

  <div class="header-actions">
    <a
      class="ticket-button"
      href="https://www.sympla.com.br/evento/parar-summit-26/3273575?utm_source=site_oficial&utm_medium=referral&utm_campaign=parar_summit_26&utm_content=header_ingressos"
      target="_blank"
      rel="noopener noreferrer"
    >
      Ingressos
    </a>

    <a class="eu-vou-button" href="/eu-vou" id="eu-vou-header-btn"> #EuVou </a>

    <a
      class="cronograma-button"
      href="/cronograma"
    >
      Cronograma
    </a>

    <nav class="menu" id="main-menu">
      <a
        class="menu-cronograma"
        href="/cronograma"
      >
        Cronograma completo
      </a>
      <a href="/#trilhas">Trilhas de conteúdo</a>
      <a href="/#plenaria">Plenária principal</a>
      <a href="/#mapa-evento">Mapa do evento</a>
      <a href="/#test-drive">Test Drive</a>
      <a href="/#patrocinio">Patrocinadores</a>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&display=swap");

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
  }

  .site-header {
    font-family: "Raleway", sans-serif;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;

    width: 100%;
    box-sizing: border-box;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px;

    padding: 24px clamp(24px, 4vw, 80px);

    background: #00c264;

    transition:
      padding 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .site-header.scrolled {
    background: rgba(2, 70, 83, 0.48);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    border-bottom: 1px solid rgba(255, 255, 255, 0.08);

    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.12);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo img {
    height: 44px;
    display: block;
  }

  .header-actions {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    margin-left: auto;
    min-width: 0;
  }

  .eu-vou-button {
    font-family: "Raleway", sans-serif;
    min-height: 46px;
    padding: 0 22px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 6px;
    border: 2px solid rgba(255, 255, 255, 0.85);

    background: transparent;
    color: #ffffff;

    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;

    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.03em;

    transition:
      background 0.22s ease,
      color 0.22s ease,
      transform 0.22s ease,
      border-color 0.22s ease;
  }

  .eu-vou-button:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
  }

  .ticket-button {
    font-family: "Raleway", sans-serif;
    min-height: 46px;
    padding: 0 24px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 6px;

    background: #074157;
    color: #ffffff;

    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;

    font-size: 13px;
    font-weight: 900;

    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  .ticket-button:hover {
    background: #06353e;
    transform: translateY(-2px);
  }

  .cronograma-button {
    font-family: "Raleway", sans-serif;
    min-height: 46px;
    padding: 0 20px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    border-radius: 6px;

    background: #ffffff;
    color: #074157;

    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;

    font-size: 13px;
    font-weight: 900;

    transition:
      transform 0.25s ease,
      background 0.25s ease;
  }

  .cronograma-button:hover {
    background: #e6fff2;
    transform: translateY(-2px);
  }

  /* item do cronograma no menu: só aparece no menu mobile */
  .menu .menu-cronograma {
    display: none;
  }

  .menu {
    justify-self: end;
    margin-left: auto;

    display: flex;
    align-items: center;
    gap: 4px;

    padding: 10px 12px;

    border-radius: 12px;

    background: rgba(6, 72, 82, 0.14);
  }

  .menu a {
    font-family: "Raleway", sans-serif;
    color: #ffffff;

    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;

    font-size: 13px;
    font-weight: 900;
    padding: 10px;
    border-radius: 8px;
  }

  .menu a:hover {
    opacity: 0.78;
  }

  .menu-toggle {
    width: 48px;
    height: 48px;

    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;

    padding: 0;
    border: 0;
    border-radius: 4px;

    background: rgba(6, 72, 82, 0.18);

    cursor: pointer;
  }

  .menu-toggle span {
    width: 26px;
    height: 3px;

    border-radius: 999px;

    background: #ffffff;

    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  /* notebooks: tudo continua visível, só um pouco mais compacto */
  @media (max-width: 1699px) and (min-width: 1280px) {
    .site-header {
      gap: 16px;
      padding: 18px clamp(20px, 2.5vw, 48px);
    }

    .logo img {
      height: 38px;
      max-width: none;
    }

    .header-actions {
      gap: 8px;
    }

    .ticket-button,
    .eu-vou-button,
    .cronograma-button {
      min-height: 42px;
      padding-inline: 16px;
      font-size: 12px;
    }

    .menu {
      padding: 6px 8px;
      gap: 0;
    }

    .menu a {
      font-size: 12px;
      padding: 8px;
    }
  }

  /* telas médias: links viram hambúrguer, botões principais continuam visíveis */
  @media (max-width: 1279px) {
    .menu-toggle {
      display: flex;
    }

    .menu-toggle.open span:nth-child(1) {
      transform: translateY(9px) rotate(45deg);
    }

    .menu-toggle.open span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.open span:nth-child(3) {
      transform: translateY(-9px) rotate(-45deg);
    }

    .menu {
      position: absolute;
      top: calc(100% + 30px);
      right: 0;
      width: 300px;
      box-sizing: border-box;

      flex-direction: column;
      align-items: stretch;
      gap: 0;

      padding: 10px;
      border-radius: 14px;

      background: rgba(2, 70, 83, 0.97);
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);

      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-12px);

      transition:
        opacity 0.3s ease,
        transform 0.3s ease,
        visibility 0.3s ease;
    }

    .menu.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .menu a {
      padding: 14px;
      border-radius: 10px;
    }

    .menu a:hover {
      background: rgba(255, 255, 255, 0.08);
      opacity: 1;
    }
  }

  @media (max-width: 1100px) and (min-width: 901px) {
    .site-header {
      gap: 16px;
      padding: 20px 24px;
    }

    .logo img {
      height: 38px;
    }

    .header-actions {
      gap: 8px;
    }

    .ticket-button,
    .eu-vou-button,
    .cronograma-button {
      font-size: 12px;
      padding-inline: 14px;
    }
  }

  @media (max-width: 900px) {
    .site-header {
      display: flex;
      flex-direction: column;
      justify-content: center;

      gap: 12px;
      padding: 14px 18px;
    }

    .logo {
      width: 100%;
      justify-content: center;
      margin-left: 0;
    }

    .logo img {
      height: 38px;
      max-width: 220px;
    }

    .header-actions {
      position: static;
      width: 100%;
      justify-content: center;
      gap: 10px;
    }

    .eu-vou-button {
      min-height: 40px;
      padding: 0 16px;
      font-size: 13px;
      border-radius: 3px;
    }

    .ticket-button {
      min-width: 120px;
      min-height: 40px;
      padding: 0 18px;

      border-radius: 3px;

      background: #074157;

      font-size: 13px;
      font-weight: 700;
    }

    /* no mobile o cronograma vai para o topo do menu, em destaque */
    .cronograma-button {
      display: none;
    }

    .menu .menu-cronograma {
      display: block;
      margin-bottom: 6px;
      background: #08d16e;
      color: #074157;
    }

    .menu .menu-cronograma:hover {
      background: #0be07a;
    }

    .menu-toggle {
      width: 40px;
      height: 40px;

      display: flex;

      border-radius: 3px;
    }

    .menu-toggle span {
      width: 20px;
      height: 2px;
    }

    .menu {
      position: absolute;
      top: calc(100% + 8px);
      left: 16px;
      right: 16px;
      min-width: 0;
      box-sizing: border-box;

      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;

      padding: 10px;

      border-radius: 14px;

      background: rgba(2, 70, 83, 0.97);

      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);

      opacity: 0;
      visibility: hidden;
      pointer-events: none;

      transform: translateY(-12px);

      transition:
        opacity 0.3s ease,
        transform 0.3s ease,
        visibility 0.3s ease;
    }

    .menu.open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;

      transform: translateY(0);
    }

    .menu a {
      padding: 16px 14px;

      border-radius: 10px;

      text-align: center;
      font-size: 13px;
    }

    .menu a:hover {
      background: rgba(255, 255, 255, 0.08);
      opacity: 1;
    }

    .menu-toggle.open span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }

    .menu-toggle.open span:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.open span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }

  @media (max-width: 430px) {
    .site-header {
      gap: 10px;
      padding: 12px 14px;
    }

    .logo img {
      height: 34px;
      max-width: 205px;
    }

    .ticket-button {
      min-width: 108px;
      min-height: 36px;
      padding-inline: 15px;

      font-size: 12px;
    }

    .menu-toggle {
      width: 36px;
      height: 36px;
    }

    .menu-toggle span {
      width: 19px;
    }
  }
</style>

<script>
  function iniciarHeader() {
    const header = document.querySelector(".site-header");
    const toggle = document.querySelector(".menu-toggle");
    const menu = document.querySelector(".menu");
    const numeros = document.querySelector("#numeros");

    if (!(header instanceof HTMLElement)) return;

    function fecharMenu() {
      if (!(toggle instanceof HTMLButtonElement)) return;
      if (!(menu instanceof HTMLElement)) return;

      menu.classList.remove("open");
      toggle.classList.remove("open");

      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Abrir menu");
    }

    if (
      toggle instanceof HTMLButtonElement &&
      menu instanceof HTMLElement &&
      toggle.dataset.ready !== "true"
    ) {
      toggle.dataset.ready = "true";

      toggle.addEventListener("click", () => {
        const isOpen = menu.classList.toggle("open");

        toggle.classList.toggle("open", isOpen);
        toggle.setAttribute("aria-expanded", String(isOpen));
        toggle.setAttribute(
          "aria-label",
          isOpen ? "Fechar menu" : "Abrir menu",
        );
      });

      menu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", fecharMenu);
      });

      document.addEventListener("click", (event) => {
        const target = event.target;

        if (target instanceof Element && !target.closest(".site-header")) {
          fecharMenu();
        }
      });
    }

    function atualizarHeader() {
      if (!(numeros instanceof HTMLElement)) {
        header.classList.remove("scrolled");
        return;
      }

      const fimDosNumeros =
        numeros.offsetTop + numeros.offsetHeight - header.offsetHeight;

      header.classList.toggle("scrolled", window.scrollY > fimDosNumeros);
    }

    function ajustarEspacoDoHeader() {
      document.body.style.paddingTop = `${header.offsetHeight}px`;
    }

    atualizarHeader();
    ajustarEspacoDoHeader();

    // a altura do header muda depois do load (fontes, logo, breakpoints):
    // recalcula o espaço sempre que ela mudar
    if (header.dataset.observed !== "true") {
      header.dataset.observed = "true";
      new ResizeObserver(ajustarEspacoDoHeader).observe(header);
    }

    window.addEventListener("scroll", atualizarHeader, { passive: true });

    window.addEventListener("resize", () => {
      ajustarEspacoDoHeader();
      atualizarHeader();
    });
  }

  iniciarHeader();

  document.addEventListener("astro:page-load", iniciarHeader);
</script>
